<Window x:Class="BatchImageCropper.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dışa Aktarma Ayarları"
        Icon="/bic.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="14" Text="Dışa Aktarma Ayarları" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="FormatLabel" Text="Format:" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Name="FormatCombo" Grid.Column="1" Margin="0,4" SelectionChanged="FormatCombo_SelectionChanged">
                <ComboBoxItem Tag="source" Content="Kaynak formatını koru"/>
                <ComboBoxItem Tag="jpg" Content="JPG (JPEG)"/>
                <ComboBoxItem Tag="png" Content="PNG"/>
                <ComboBoxItem Tag="bmp" Content="BMP"/>
                <ComboBoxItem Tag="gif" Content="GIF"/>
            </ComboBox>

            <TextBlock x:Name="QualityLabelTitle" Text="Kalite:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                <TextBlock x:Name="QualityValueLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Text="95" Width="34" TextAlignment="Right"/>
                <Slider Name="QualitySlider" Minimum="50" Maximum="100" Value="95"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="QualitySlider_ValueChanged"/>
            </DockPanel>

            <TextBlock x:Name="SuffixLabel" Text="Son ek:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Name="SuffixBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="_kirpilmis"/>

            <CheckBox Name="SourceFolderCheck" Grid.Row="3" Grid.ColumnSpan="2"
                      Content="Kaynak klasörünü kullan" Margin="0,8,0,0"
                      Checked="SourceFolder_Toggled" Unchecked="SourceFolder_Toggled"/>

            <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,6,0,0">
                <Button Name="BrowseButton" DockPanel.Dock="Right" Content="Seç..." Width="70" Margin="8,0,0,0" IsEnabled="False" Click="Browse_Click"/>
                <TextBox Name="FolderBox" IsEnabled="False" VerticalContentAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="FolderHintText" Grid.Row="5" Grid.ColumnSpan="2"
                       Foreground="#777" FontSize="11" Margin="0,4,0,0"
                       Text="Klasör seçilmezse kaynak klasörü kullanılır."/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="Tamam" Width="80" Margin="0,0,8,0"
                    Background="#BFEFBB" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="İptal" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>